FROM nginx:alpine

RUN apk add --no-cache curl

COPY nginx.conf /etc/nginx/nginx.conf

# The certificate files are mounted by docker-compose at runtime. Keeping the
# HTTP listener also makes the container health check and redirect/load-balancer
# integrations straightforward.
RUN sed -i 's/listen 80;/listen 80;\n        listen 443 ssl;\n        ssl_certificate \/etc\/nginx\/certs\/fullchain.pem;\n        ssl_certificate_key \/etc\/nginx\/certs\/privkey.pem;\n        ssl_protocols TLSv1.2 TLSv1.3;/' /etc/nginx/nginx.conf

RUN mkdir -p /var/log/nginx && chown -R nginx:nginx /var/log/nginx

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1
